VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Preview mode runs the app with a fake session and no server. Leave it off for real builds.
VITE_DEMO_MODE=false
# Web push. The PUBLIC key is safe in the bundle; the private half is an Edge
# Function secret only (VAPID_PRIVATE_KEY), never a VITE_ variable.
VITE_VAPID_PUBLIC_KEY=

# Server-only secrets belong in Supabase Edge Function secrets, never Vite:
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
# MODEL_API_KEY=  # Set as an Edge Function secret only; never put in VITE_*.
